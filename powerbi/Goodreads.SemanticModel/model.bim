            "formatString": "0.0%",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "165ab374-f221-52ec-9215-7779264bf684"
          },
          {
            "name": "Fiches annee invalide",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[AnneeInvalide] = TRUE())), 0)",
            "formatString": "#,0",
