          {
            "name": "Fiches titre auteur repete",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[TitreAuteurRepete] = TRUE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "d7a6c272-54f2-59a7-b9f2-2b017dd89f70"
