        "partitions": [
          {
            "name": "Livres",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DossierDonnees & \"\\livres_powerbi.csv\"), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Vides = Table.ReplaceValue(Entetes, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Entetes)),",
                "    Types = Table.TransformColumnTypes(Vides, {{\"IdLivre\", Int64.Type}, {\"Titre\", type text}, {\"Auteurs\", type text}, {\"Editeur\", type text}, {\"ISBN\", type text}, {\"Langue\", type text}, {\"Note\", type number}, {\"NbNotes\", Int64.Type}, {\"Pages\", Int64.Type}, {\"AnneePublication\", Int64.Type}, {\"TranchePages\", type text}, {\"TrancheNotes\", type text}, {\"PeriodePublication\", type text}, {\"NoteExploitable\", type logical}, {\"DistributionValide\", type logical}, {\"LangueAbsente\", type logical}, {\"EditeurAbsent\", type logical}, {\"AuteurAbsent\", type logical}, {\"PagesAbsentes\", type logical}, {\"PagesAtypiques\", type logical}, {\"AnneeInvalide\", type logical}, {\"TitreAuteurRepete\", type logical}, {\"Candidat\", type logical}, {\"RepresentantSelection\", type logical}, {\"DansTop20\", type logical}, {\"RangSelection\", Int64.Type}, {\"OrdrePages\", Int64.Type}, {\"OrdreNotes\", Int64.Type}, {\"OrdrePeriode\", Int64.Type}, {\"FichierSource\", type text}, {\"LigneSource\", Int64.Type}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Nombre de fiches",
            "expression": "COALESCE(COUNTROWS(Livres), 0)",
            "formatString": "#,0",
            "displayFolder": "Catalogue",
            "description": "Grain : une fiche Goodreads, pas une œuvre unique.",
            "lineageTag": "c4f46281-4931-5b93-af9a-f867c25e54f1"
          },
          {
            "name": "Fiches note exploitable",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[NoteExploitable] = TRUE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Catalogue",
            "description": "",
            "lineageTag": "eb9e4392-afb3-5279-bbc6-ed2d7b9c6ab6"
          },
          {
            "name": "Part note exploitable",
            "expression": "DIVIDE([Fiches note exploitable], [Nombre de fiches])",
            "formatString": "0.0%",
            "displayFolder": "Catalogue",
            "description": "",
            "lineageTag": "56054a1d-7923-5f55-a634-25baf25bceb3"
          },
          {
            "name": "Note moyenne",
            "expression": "AVERAGE(Livres[Note])",
            "formatString": "0.00",
            "displayFolder": "Catalogue",
            "description": "Moyenne non pondérée des notes exploitables des fiches. Chaque fiche a le même poids.",
            "lineageTag": "f31c57e4-4cca-5a52-94b0-d580508095e4"
          },
          {
            "name": "Note mediane",
            "expression": "MEDIAN(Livres[Note])",
            "formatString": "0.00",
            "displayFolder": "Catalogue",
            "description": "",
            "lineageTag": "d1d5099c-329a-5e94-b9d1-1200349d40f8"
          },
          {
            "name": "Mediane nombre de notes",
            "expression": "MEDIAN(Livres[NbNotes])",
            "formatString": "#,0",
            "displayFolder": "Catalogue",
            "description": "Inclut les fiches à zéro note. Ne somme pas les compteurs entre éditions.",
            "lineageTag": "58906c4a-f3ed-59b3-b43d-d6df38c21ed3"
          },
          {
            "name": "Fiches 100 notes",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[NbNotes] >= 100)), 0)",
            "formatString": "#,0",
            "displayFolder": "Catalogue",
            "description": "",
            "lineageTag": "92fbbdb8-853c-59ef-8c02-8e0c227aac7a"
          },
          {
            "name": "Part 100 notes",
            "expression": "DIVIDE([Fiches 100 notes], [Nombre de fiches])",
            "formatString": "0.0%",
            "displayFolder": "Catalogue",
            "description": "",
            "lineageTag": "7f476af5-c161-5fb7-b601-1819be7e1158"
          },
          {
            "name": "Fiches sans notation",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[NbNotes] == 0)), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "8c2dd824-b474-585c-8629-c0e50ec2d2cf"
          },
          {
