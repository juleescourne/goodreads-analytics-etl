          {
            "name": "Part titre auteur repete",
            "expression": "DIVIDE([Fiches titre auteur repete], [Nombre de fiches])",
            "formatString": "0.0%",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "5fd28951-8df5-563e-ad5d-daa76c1e35b5"
          },
          {
            "name": "Fiches note incoherente",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[NbNotes] > 0), KEEPFILTERS(Livres[NoteExploitable] = FALSE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "b4563bf7-57a1-5711-8aab-9f339f9314b4"
          },
          {
            "name": "Candidats",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[Candidat] = TRUE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Selection",
            "description": "Marqueur fixe de la source complète ; les filtres réduisent l’affichage sans recalculer la sélection.",
            "lineageTag": "35712d47-a049-5bbb-b244-df3ecf962891"
          },
          {
            "name": "Representants",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[RepresentantSelection] = TRUE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Selection",
            "description": "Marqueur fixe de la source complète ; les filtres réduisent l’affichage sans recalculer la sélection.",
            "lineageTag": "fcc6879f-72ec-563c-a35a-ae67bde3cfcf"
          },
          {
            "name": "Liste de travail",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Livres), KEEPFILTERS(Livres[DansTop20] = TRUE())), 0)",
            "formatString": "#,0",
            "displayFolder": "Selection",
            "description": "Marqueur fixe de la source complète ; les filtres réduisent l’affichage sans recalculer la sélection.",
            "lineageTag": "a889fdaa-621b-5a57-ac8a-8727e69b34f9"
          },
          {
            "name": "Note mediane groupe",
            "expression": "IF([Fiches note exploitable] >= 30, [Note mediane])",
            "formatString": "0.00",
            "displayFolder": "Selection",
            "description": "Masque la médiane sous 30 fiches notées. Seuil de lecture, pas test statistique.",
            "lineageTag": "2015641d-4c95-552c-b0e9-61093d369948"
          },
          {
            "name": "Rang de la fiche",
            "expression": "SELECTEDVALUE(Livres[RangSelection])",
            "formatString": "#,0",
            "displayFolder": "Selection",
            "description": "",
            "lineageTag": "b292e18b-bf69-5e8d-ab50-9b08c519d2f9"
          },
          {
            "name": "Note de la fiche",
            "expression": "SELECTEDVALUE(Livres[Note])",
            "formatString": "0.00",
            "displayFolder": "Selection",
            "description": "",
            "lineageTag": "6d146a59-3e39-5c57-8314-59ff5d3f719e"
          },
          {
            "name": "Nombre de notes fiche",
            "expression": "SELECTEDVALUE(Livres[NbNotes])",
            "formatString": "#,0",
            "displayFolder": "Selection",
            "description": "",
            "lineageTag": "23b7dbcd-7404-5932-8c71-d0d700f2a12b"
          },
          {
            "name": "Lignes brutes",
            "expression": "CALCULATE(SUM(AuditImport[Effectif]), AuditImport[Controle] = \"Lignes brutes\")",
            "formatString": "#,0",
            "displayFolder": "Import complet",
            "description": "Import complet, indépendant des filtres du catalogue.",
            "lineageTag": "b88a9b3a-1aad-5a64-bfe0-84b340a3b7b6"
          },
          {
            "name": "Repetitions retirees",
            "expression": "CALCULATE(SUM(AuditImport[Effectif]), AuditImport[Controle] = \"Répétitions retirées\")",
            "formatString": "#,0",
            "displayFolder": "Import complet",
            "description": "Import complet, indépendant des filtres du catalogue.",
            "lineageTag": "dd319b8f-abd0-5b73-98ad-19a0855a8923"
          },
          {
            "name": "Lignes quarantaine",
            "expression": "CALCULATE(SUM(AuditImport[Effectif]), AuditImport[Controle] = \"Lignes en quarantaine\")",
            "formatString": "#,0",
            "displayFolder": "Import complet",
            "description": "Import complet, indépendant des filtres du catalogue.",
            "lineageTag": "d6a0e60f-7b88-5162-b74f-2f5223f8e2ad"
          }
        ]
      },
      {
        "name": "Langues",
        "lineageTag": "3efee69f-f685-55b3-aa7f-839841800c7c",
